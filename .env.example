# Dokploy Environment Configuration
POSTGRES_USER=yap_user
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=youtube_analytics

# Backend Secrets
# Generate random 32-byte hex for SECRET_KEY (e.g. openssl rand -hex 32)
SECRET_KEY=generate_a_32_byte_hex_secret_here

# Generate 32-byte url-safe base64 for AES-256 Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate_a_fernet_key_here

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
TELEGRAM_WEBHOOK_SECRET=optional_random_secret_token

# Domains for Dokploy & Traefik
DOKPLOY_WEB_DOMAIN=yap.oxyjet.win
DOKPLOY_API_DOMAIN=api.yap.oxyjet.win
